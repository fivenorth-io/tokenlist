{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Loop asset metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "network", "assetKey", "adminParty", "instrumentId", "issuerName", "name", "symbol", "decimals", "logo", "website", "registryUrl", "wallet", "data", "pricing"],
  "properties": {
    "schemaVersion": {"const": 1, "description": "Use integer notation."},
    "network": {"enum": ["mainnet", "devnet", "testnet"]},
    "assetKey": {"allOf": [{"$ref": "#/definitions/text"}], "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]*$"},
    "adminParty": {"type": "string", "maxLength": 255, "pattern": "^[^\\s:]+::1220[0-9a-f]{64}$"},
    "instrumentId": {"$ref": "#/definitions/text"},
    "issuerName": {"$ref": "#/definitions/text"},
    "name": {"$ref": "#/definitions/text"},
    "symbol": {"allOf": [{"$ref": "#/definitions/text"}], "maxLength": 64},
    "decimals": {"type": "integer", "minimum": 0, "maximum": 10, "description": "Use integer notation."},
    "logo": {"type": "string", "maxLength": 256, "pattern": "\\.[pP][nN][gG]$", "description": "Relative PNG path. Square, 128-1024 pixels, at most 2 MB."},
    "website": {"$ref": "#/definitions/https"},
    "registryUrl": {"$ref": "#/definitions/https"},
    "wallet": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "visibleByDefault"],
      "properties": {"enabled": {"type": "boolean"}, "visibleByDefault": {"type": "boolean"}},
      "if": {"properties": {"enabled": {"const": false}}},
      "then": {"properties": {"visibleByDefault": {"const": false}}}
    },
    "data": {
      "type": "object", "additionalProperties": false, "required": ["listed"],
      "properties": {"listed": {"type": "boolean"}}
    },
    "pricing": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "sources"],
          "properties": {
            "type": {"enum": ["direct", "reference"]},
            "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/source"}}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "currency", "value"],
          "properties": {"type": {"const": "fixed"}, "currency": {"const": "USD"}, "value": {"$ref": "#/definitions/positiveDecimal"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": {"type": {"const": "none"}}
        }
      ]
    }
  },
  "definitions": {
    "text": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:[\\s\\S]*\\S)?$", "not": {"pattern": "[\u0000-\u001f\u007f]"}},
    "https": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://[^/?#@]+(?:[/?][^#]*)?$"},
    "positiveDecimal": {"type": "string", "pattern": "^(0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(\\.[0-9]+)?)$"},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["provider", "providerAssetId"],
      "properties": {
        "provider": {"enum": ["coinmarketcap", "coingecko"]},
        "providerAssetId": {"$ref": "#/definitions/text"},
        "multiplier": {"allOf": [{"$ref": "#/definitions/positiveDecimal"}], "default": "1"},
        "kind": {"enum": ["market", "nav", "issuer_reference"], "default": "market", "description": "What the quote measures: a traded market price, an issuer-reported NAV, or an issuer-reported reference price. Sources of different kinds are separate series and never stand in for each other."},
        "maxAge": {"type": "integer", "minimum": 0, "maximum": 604800, "description": "Seconds a quote may age before the consumer asks the next source of the same kind, at most 604800 (7 days). 0 accepts any age. Without it, the consumer uses its own default. Use integer notation."}
      },
      "if": {"properties": {"provider": {"const": "coinmarketcap"}}},
      "then": {"properties": {"providerAssetId": {"pattern": "^[1-9][0-9]*$", "maxLength": 19}}},
      "else": {"properties": {"providerAssetId": {"pattern": "^[a-z0-9][a-z0-9._-]*$"}}}
    }
  }
}
